<?xml version="1.0"?>
<!-- Kinetix for Garmin (Connect IQ). The application id is shared with the iPhone app
     (GarminSync.watchAppId) so the two can talk through Garmin Connect. -->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application id="80ce02b89c7d47bf9ddbaedbbd400dea" type="watch-app" name="@Strings.AppName"
                    entry="KinetixApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.2.0">
        <iq:products>
            <iq:product id="fr965"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Fit"/>
            <iq:uses-permission id="Positioning"/>
            <iq:uses-permission id="Sensor"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>

// Copy this file to Config/Secrets.xcconfig (which git ignores) and fill in values.
// Never commit Secrets.xcconfig.

// Your Apple Developer Team ID (Xcode > Settings > Accounts, or developer.apple.com > Membership).
DEVELOPMENT_TEAM =

// Supabase (Milestone 7). Note: "//" starts a comment in xcconfig files, so URLs are written with $() in the middle.
SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY =

// Strava: the numeric Client ID from strava.com/settings/api (see docs/STRAVA.md).
STRAVA_CLIENT_ID =
// Normally the client secret is NOT put here: it lives in Supabase as an Edge Function secret.
// Only until Supabase is set up (testing builds), it can go here instead. Leave it empty once
// Supabase is configured, and never commit this file. See docs/STRAVA.md.
STRAVA_CLIENT_SECRET =

// Instagram Stories sharing: your Meta (Facebook) App ID (not secret). See docs/SHARING.md.
INSTAGRAM_APP_ID =

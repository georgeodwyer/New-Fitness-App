// Copy this file to Config/Secrets.xcconfig (which git ignores) and fill in values.
// Never commit Secrets.xcconfig.

// Your Apple Developer Team ID (Xcode > Settings > Accounts, or developer.apple.com > Membership).
DEVELOPMENT_TEAM =

// Supabase (Milestone 7). Note: "//" starts a comment in xcconfig files, so URLs are written with $() in the middle.
SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY =

// Strava (Milestone 8).
STRAVA_CLIENT_ID =

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Kinetix</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.georgeodwyer.kinetix</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kinetix</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.georgeodwyer.kinetix.garmin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kinetix-ciq</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>InstagramAppID</key>
	<string>$(INSTAGRAM_APP_ID)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram-stories</string>
		<string>gcm-ciq</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Kinetix connects to Bluetooth heart rate straps to show live heart rate during workouts.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Kinetix reads heart rate, resting heart rate, HRV, sleep, steps, active energy, VO2 max, breathing rate and workouts to show your body trends, judge recovery and balance your training load.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Kinetix saves your completed runs and strength sessions to Apple Health.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Kinetix keeps tracking your run with the screen locked so pace coaching and splits keep working.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Kinetix uses your location during runs to measure distance and pace and draw your route, and to centre the map when you plan a route.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Kinetix saves the run and workout cards you choose to your photo library.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>StravaClientID</key>
	<string>$(STRAVA_CLIENT_ID)</string>
	<key>StravaClientSecret</key>
	<string>$(STRAVA_CLIENT_SECRET)</string>
	<key>SupabaseAnonKey</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>SupabaseURL</key>
	<string>$(SUPABASE_URL)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>audio</string>
		<string>bluetooth-central</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
